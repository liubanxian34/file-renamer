<Window x:Class="Renamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量改名器" Height="760" Width="1200" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        Background="#FBFBFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="添加文件" Click="AddFiles" />
                <Button Content="添加文件夹" Click="AddFolders" />
                <Button Content="清空列表" Click="ClearList" />
                <Rectangle Width="1" Height="18" Fill="{StaticResource Line}" Margin="6,0,10,0" />
                <TextBlock Text="顺序" Foreground="{StaticResource Sub}" Margin="0,0,6,0" />
                <ComboBox x:Name="SortBox" Width="150" SelectedIndex="0" SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="按名称（自然排序）" />
                    <ComboBoxItem Content="按修改时间" />
                    <ComboBoxItem Content="按大小" />
                    <ComboBoxItem Content="按路径" />
                </ComboBox>
                <TextBlock x:Name="SortHint" Foreground="{StaticResource Sub}" Margin="10,0,0,0"
                           Text="序号按这个顺序编" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="8,6,8,0" Background="Transparent" BorderThickness="0">
            <!-- ============ 批量重命名 ============ -->
            <TabItem Header="  批量重命名  ">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 规则链 -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="10,8" Background="#F7F8FA">
                                <TextBlock Text="规则链（从上到下依次作用）" Foreground="{StaticResource Sub}" />
                            </Border>

                            <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="KindBox" Width="132" SelectedIndex="0">
                                        <ComboBoxItem Content="查找替换" />
                                        <ComboBoxItem Content="插入文字" />
                                        <ComboBoxItem Content="删除 / 截取" />
                                        <ComboBoxItem Content="序号" />
                                        <ComboBoxItem Content="日期" />
                                        <ComboBoxItem Content="大小写" />
                                        <ComboBoxItem Content="清理字符" />
                                        <ComboBoxItem Content="扩展名" />
                                    </ComboBox>
                                    <Button Content="添加规则" Click="AddRule" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                                <ItemsControl x:Name="RuleList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,7"
                                                    MouseLeftButtonDown="RuleRowMouseDown" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                              Margin="0,0,8,0" Click="RuleToggle" ToolTip="启用 / 停用" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Sub}"
                                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="↑" Width="24" MinWidth="24" Padding="0" Height="22" Tag="{Binding}" Click="RuleUp" ToolTip="上移" />
                                                        <Button Content="↓" Width="24" MinWidth="24" Padding="0" Height="22" Tag="{Binding}" Click="RuleDown" ToolTip="下移" />
                                                        <Button Content="✕" Width="24" MinWidth="24" Padding="0" Height="22" Tag="{Binding}" Click="RuleDel" ToolTip="删除" Margin="0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- 预览 -->
                    <DockPanel Grid.Column="1">
                        <Border DockPanel.Dock="Bottom" Padding="0,8,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Summary" VerticalAlignment="Center" Foreground="{StaticResource Sub}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="全选" Click="CheckAll" />
                                    <Button Content="全不选" Click="UncheckAll" />
                                    <Button Content="撤销上一批" Click="UndoLast" />
                                    <Button Content="执行改名" Style="{StaticResource Primary}" Click="RunRename" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="Grid" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource Line}" BorderBrush="{StaticResource Line}"
                                  Background="White" RowHeight="28" SelectionMode="Extended" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="34" />
                                <DataGridTextColumn Header="原文件名" Binding="{Binding Name}" Width="2.2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="新文件名" Binding="{Binding NewName}" Width="2.2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="86" IsReadOnly="True" />
                                <DataGridTextColumn Header="所在文件夹" Binding="{Binding Dir}" Width="3*" IsReadOnly="True" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="重名">
                                            <Setter Property="Foreground" Value="#C0392B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="已存在">
                                            <Setter Property="Foreground" Value="#C0392B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="名称为空">
                                            <Setter Property="Foreground" Value="#C0392B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ 批量新建 ============ -->
            <TabItem Header="  批量新建  ">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="目标文件夹" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CreateDir" />
                                <Button Grid.Column="1" Content="浏览" Margin="6,0,0,0" Click="PickCreateDir" />
                            </Grid>

                            <TextBlock Text="建什么" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ComboBox x:Name="CreateKind" Width="110" SelectedIndex="0" SelectionChanged="OnCreateKindChanged">
                                    <ComboBoxItem Content="文件夹" />
                                    <ComboBoxItem Content="空文件" />
                                </ComboBox>
                                <TextBlock Text="扩展名" Foreground="{StaticResource Sub}" Margin="12,0,6,0" />
                                <TextBox x:Name="CreateExt" Width="90" Text="txt" />
                            </StackPanel>

                            <TextBlock Text="命名方式" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CreateMode" SelectedIndex="0" Margin="0,0,0,10" SelectionChanged="OnCreateKindChanged">
                                <ComboBoxItem Content="序号：001、002、003…" />
                                <ComboBoxItem Content="名单：一行一个，用我给的文字" />
                                <ComboBoxItem Content="日期+序号：20261106_01…" />
                            </ComboBox>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="起始" Foreground="{StaticResource Sub}" />
                                    <TextBox x:Name="CreateStart" Text="1" TextChanged="OnCreateChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="位数" Foreground="{StaticResource Sub}" />
                                    <TextBox x:Name="CreateDigits" Text="3" TextChanged="OnCreateChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="数量" Foreground="{StaticResource Sub}" />
                                    <TextBox x:Name="CreateCount" Text="10" TextChanged="OnCreateChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="步长" Foreground="{StaticResource Sub}" />
                                    <TextBox x:Name="CreateStep" Text="1" TextChanged="OnCreateChanged" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="前缀" Foreground="{StaticResource Sub}" />
                                    <TextBox x:Name="CreatePrefix" TextChanged="OnCreateChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="后缀" Foreground="{StaticResource Sub}" />
                                    <TextBox x:Name="CreateSuffix" TextChanged="OnCreateChanged" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="ListLabel" Text="名单（一行一个）" Foreground="{StaticResource Sub}" Margin="0,0,0,4" Visibility="Collapsed" />
                            <TextBox x:Name="CreateList" Height="96" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" Visibility="Collapsed" TextChanged="OnCreateChanged" />

                            <Button Content="开始创建" Style="{StaticResource Primary}" Margin="0,12,0,0" Click="RunCreate" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Column="1">
                        <Border DockPanel.Dock="Top" Padding="0,0,0,6">
                            <TextBlock x:Name="CreateSummary" Foreground="{StaticResource Sub}" Text="将创建 10 项" />
                        </Border>
                        <ListBox x:Name="CreatePreview" BorderBrush="{StaticResource Line}" Background="White" FontFamily="Consolas" FontSize="12" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Sub}" Text="把文件拖进来，或点左上角添加" />
        </Border>
    </Grid>
</Window>
