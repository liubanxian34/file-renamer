<Window x:Class="Renamer.RuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑规则" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13" Background="#FBFBFC">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" Text="规则" />

        <StackPanel Grid.Row="1">

            <!-- 查找替换 -->
            <StackPanel x:Name="BoxReplace">
                <TextBlock Text="查找" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <TextBox x:Name="FindBox" Margin="0,0,0,10" />
                <TextBlock Text="替换为（留空 = 删除）" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <TextBox x:Name="ReplaceBox" Margin="0,0,0,10" />
                <CheckBox x:Name="RegexBox" Content="用正则表达式（可用 $1 引用分组）" Margin="0,0,0,6" />
                <CheckBox x:Name="IgnoreCaseBox" Content="忽略大小写" Margin="0,0,0,6" />
                <CheckBox x:Name="NameOnlyBox" Content="只改主名，不动扩展名" />
            </StackPanel>

            <!-- 插入 -->
            <StackPanel x:Name="BoxInsert" Visibility="Collapsed">
                <TextBlock Text="要插入的文字" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <TextBox x:Name="InsertText" Margin="0,0,0,10" />
                <TextBlock Text="插到哪里" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <ComboBox x:Name="InsertAtBox" SelectedIndex="0" Margin="0,0,0,10">
                    <ComboBoxItem Content="开头" />
                    <ComboBoxItem Content="结尾" />
                    <ComboBoxItem Content="第 N 个字符之后" />
                </ComboBox>
                <TextBlock Text="N（选上面第三项才用到）" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <TextBox x:Name="InsertPos" Text="0" />
            </StackPanel>

            <!-- 删除 -->
            <StackPanel x:Name="BoxDelete" Visibility="Collapsed">
                <CheckBox x:Name="BySepBox" Content="按分隔符分段，删掉其中一段" Margin="0,0,0,8"
                          Checked="BySepChanged" Unchecked="BySepChanged" />
                <StackPanel x:Name="SepPanel">
                    <TextBlock Text="分隔符" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                    <TextBox x:Name="SepBox" Text="-" Margin="0,0,0,8" />
                    <TextBlock Text="删掉第几段" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                    <TextBox x:Name="SegBox" Text="1" />
                </StackPanel>
                <StackPanel x:Name="PosPanel">
                    <TextBlock Text="从第几个字符开始删" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                    <TextBox x:Name="DelFrom" Text="1" Margin="0,0,0,8" />
                    <TextBlock Text="删几个（0 = 删到末尾）" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                    <TextBox x:Name="DelCount" Text="0" />
                </StackPanel>
            </StackPanel>

            <!-- 序号 -->
            <StackPanel x:Name="BoxNumber" Visibility="Collapsed">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="起始数字" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                        <TextBox x:Name="NumStart" Text="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="步长" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                        <TextBox x:Name="NumStep" Text="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="补零位数" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                        <TextBox x:Name="NumDigits" Text="2" />
                    </StackPanel>
                </Grid>
                <ComboBox x:Name="NumAtBox" SelectedIndex="1" Margin="0,0,0,8">
                    <ComboBoxItem Content="加到开头" />
                    <ComboBoxItem Content="加到结尾" />
                    <ComboBoxItem Content="插到第 N 个字符后" />
                    <ComboBoxItem Content="替换整个名称" />
                </ComboBox>
                <TextBlock Text="N" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <TextBox x:Name="NumPos" Text="0" />
            </StackPanel>

            <!-- 日期 -->
            <StackPanel x:Name="BoxDate" Visibility="Collapsed">
                <TextBlock Text="取哪个时间" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <ComboBox x:Name="DateFromBox" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="文件修改时间" />
                    <ComboBoxItem Content="文件创建时间" />
                    <ComboBoxItem Content="当前时间" />
                </ComboBox>
                <TextBlock Text="格式（yyyyMMdd、yyyy-MM-dd_HHmm 等）" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <TextBox x:Name="DateFmt" Text="yyyyMMdd" Margin="0,0,0,8" />
                <ComboBox x:Name="DateAtBox" SelectedIndex="0">
                    <ComboBoxItem Content="加到开头" />
                    <ComboBoxItem Content="加到结尾" />
                </ComboBox>
            </StackPanel>

            <!-- 大小写 -->
            <StackPanel x:Name="BoxCase" Visibility="Collapsed">
                <ComboBox x:Name="CaseBox" SelectedIndex="1">
                    <ComboBoxItem Content="全部大写" />
                    <ComboBoxItem Content="全部小写" />
                    <ComboBoxItem Content="首字母大写" />
                </ComboBox>
            </StackPanel>

            <!-- 清理 -->
            <StackPanel x:Name="BoxClean" Visibility="Collapsed">
                <CheckBox x:Name="TrimBox" Content="去掉首尾空格" Margin="0,0,0,6" />
                <CheckBox x:Name="CollapseBox" Content="连续空格合成一个" Margin="0,0,0,6" />
                <CheckBox x:Name="BracketBox" Content="去掉括号及其内容（）、()、【】、[]" Margin="0,0,0,6" />
                <CheckBox x:Name="SpecialBox" Content="去掉特殊符号（# $ % &amp; 等）" Margin="0,0,0,6" />
                <CheckBox x:Name="WidthBox" Content="全角字符转半角" />
            </StackPanel>

            <!-- 扩展名 -->
            <StackPanel x:Name="BoxExt" Visibility="Collapsed">
                <TextBlock Text="新扩展名（留空 = 去掉扩展名）" Foreground="{StaticResource Sub}" Margin="0,0,0,4" />
                <TextBox x:Name="ExtBox" />
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="Cancel" MinWidth="76" />
            <Button Content="确定" Style="{StaticResource Primary}" Click="Ok" MinWidth="76" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
